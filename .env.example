# Live AI goes through one endpoint that accepts POST {"prompt": "..."} and returns the model's answer.
LLM_ENDPOINT_URL=https://screen-scene-recreator.lovable.app/api/public/ask
# Optional Bearer token if you protect the endpoint
# LLM_ENDPOINT_TOKEN=

# Optional: set to 1 to also log request/response previews (may include workshop text)
# GEMINI_DEBUG=1

# Research (problem discovery) uses Gemini with Google Search grounding through the Vercel AI SDK.
# Option A: Vercel AI Gateway (on Vercel, OIDC authenticates automatically and no key is needed).
# AI_GATEWAY_API_KEY=
# Option B: call Google directly (create a key in Google AI Studio).
# GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override, as a gateway-style "google/<model>" id.
# RESEARCH_MODEL=google/gemini-3-flash
