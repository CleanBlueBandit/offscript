      "html": "<button class=\"ds-ingredient\" aria-pressed=\"true\"><span class=\"ds-label\">Mechanic</span><span class=\"ds-copy\">Detect overload and collapse the workflow to one safe next action.</span><span class=\"ds-check\" aria-hidden=\"true\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m5 12 4 4L19 6\"/></svg></span></button>",
      "css": ".ds-ingredient{font-family:var(--font-sans,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif);position:relative;display:flex;flex-direction:column;max-width:340px;min-height:103px;padding:14px 34px 15px 8px;border:1px solid transparent;border-radius:7px;text-align:left;background:var(--accent-soft,#edf3ff);cursor:pointer;transition:background .15s ease-out;}.ds-ingredient:hover{border-color:#9ab4e5;}.ds-ingredient:focus-visible{outline:3px solid #2864d880;outline-offset:3px;}.ds-ingredient:active{transform:translateY(1px);}.ds-label{font-size:11px;font-weight:450;color:#4e6da1;}.ds-copy{font-size:14px;line-height:1.6;color:#254779;margin-top:7px;}.ds-check{position:absolute;right:8px;top:45px;display:grid;place-items:center;width:19px;height:19px;border-radius:50%;background:var(--accent,#2864d8);color:#fff;}"
    }
